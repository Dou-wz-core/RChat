# Example values only. Replace the database user/password for your local database.
# ChatServer reads process environment variables; it does not load this file.
# See README.md for PowerShell setup commands. Never commit real credentials.
CHAT_DB_HOST=127.0.0.1
CHAT_DB_PORT=3306
CHAT_DB_NAME=chat_udp
CHAT_DB_USER=example_db_user
CHAT_DB_PASSWORD=example_db_password
