# 数据库连接参数示例，包含主机、端口、库名、用户名和密码。
# ChatServer/UdpClient 自动读取当前目录或 exe 旁的 .env，进程环境变量优先。
# scripts/setup-demo.ps1 会为本机演示自动生成已填好的 .env，无需手工修改示例。
# 未设置变量时使用代码中的默认值，账号和密码字段在此仅提供示例值。
CHAT_DB_HOST=127.0.0.1
CHAT_DB_PORT=3306
CHAT_DB_NAME=chat_udp
CHAT_DB_USER=example_db_user
CHAT_DB_PASSWORD=example_db_password
CHAT_BIND_IP=127.0.0.1
CHAT_BIND_PORT=6000
CHAT_SERVER_IP=127.0.0.1
CHAT_SERVER_PORT=6000
CHAT_DEMO_PASSWORD=demo123456
# 项目演示初始化会在本机 .env 中开启自动启动，并填好项目路径和 MySQL 路径。
CHAT_DEMO_AUTOSTART=0
